---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { isDue, type ReviewState } from "@/lib/srs";
import { ReviewSession } from "@/components/review/ReviewSession";
import type { Flashcard } from "@/types";

type DueCard = Pick<Flashcard, "id" | "front" | "back">;

const supabase = createClient(Astro.request.headers, Astro.cookies);
let due: DueCard[] = [];
if (supabase) {
  const now = new Date();
  // RLS scopes this to the current user's rows. MVP: fetch the deck and filter the
  // due queue in-process via the SRS helper — deck sizes are small and this sidesteps
  // fragile jsonb filter syntax + the UTC-vs-local "today" question (plan Open Q #3).
  const { data } = await supabase.from("flashcards").select("id, front, back, review_state");
  const rows = (data ?? []) as (DueCard & { review_state: ReviewState | null })[];
  due = rows
    .filter((c) => c.review_state == null || isDue(c.review_state, now))
    .map(({ id, front, back }) => ({ id, front, back }));
}
---

<Layout title="Review">
  <main class="bg-cosmic min-h-screen p-6 text-white">
    <h1 class="mb-4 text-2xl font-bold">Review</h1>
    <ReviewSession client:load cards={due} />
  </main>
</Layout>
